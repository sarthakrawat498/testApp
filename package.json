{
  "name": "lms-backend-mock",
  "version": "1.0.0",
  "private": true,
  "description": "Standalone mock LMS API for Azure App Service deployment verification",
  "main": "dist/server.js",
  "scripts": {
    "dev": "node ./node_modules/ts-node-dev/lib/bin.js --respawn --transpile-only src/server.ts",
    "build": "node ./node_modules/typescript/bin/tsc",
    "start": "node dist/server.js"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.21.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.9.0",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.6.3"
  }
}
